# Allow-list: ignora tudo por padrão, só libera o que pertence ao projeto.
# Isso evita rastrear acidentalmente .ssh, .cache, .claude, histórico de shell etc,
# já que este repositório vive na home do usuário do servidor.
/*

!/.gitignore
!/CLAUDE.md

!/device-old-pc/
!/device-old-pc/**

# artefatos de runtime/boilerplate gerados pelos containers, não fazem parte da config do projeto
/device-old-pc/services/*/config/logs/
/device-old-pc/services/*/config/kubernetes.yaml
/device-old-pc/services/*/config/bookmarks.yaml
/device-old-pc/services/*/config/custom.css
/device-old-pc/services/*/config/custom.js
/device-old-pc/services/*/config/proxmox.yaml

# AdGuard Home: work/ (querylog, stats) e conf/ (config gerada pelo wizard,
# inclui hash da senha do admin) — repo é público, isso não deve ser versionado
/device-old-pc/services/adguard-home/work/
/device-old-pc/services/adguard-home/conf/

!/device-legion-duel/
!/device-legion-duel/**

!/core/
!/core/**
